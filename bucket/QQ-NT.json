{
    "version": "9.9.32.260716",
    "description": "QQ-NT",
    "homepage": "https://im.qq.com",
    "license": "Freeware",
    "url": "https://qq-web.cdn-go.cn/im.qq.com_new/latest/rainbow/windowsConfig.js",
    "hash": "9ea923a05e5d7fe973ef97979a7f2758d047a5bf2156469f638cb1f9b0d77462",
    "pre_install": [
        "$config = Get-Content -Raw \"$dir\\windowsConfig.js\"",
        "$downloadUrl = [regex]::Match($config, '\"ntDownloadX64Url\":\"([^\"]+)\"').Groups[1].Value",
        "if (!$downloadUrl) { throw \"\u672a\u627e\u5230 QQ $version \u7684 x64 \u4e0b\u8f7d\u5730\u5740\u3002\" }",
        "$aria2 = Get-Command aria2c -ErrorAction SilentlyContinue",
        "if (!$aria2) { throw \"\u672a\u627e\u5230 aria2c\u3002\u8bf7\u5b89\u88c5 aria2 \u540e\u91cd\u8bd5\u3002\" }",
        "& $aria2.Source \"--dir=$dir\" '--out=QQ-NT.exe' '--allow-overwrite=true' '--auto-file-renaming=false' '--summary-interval=0' $downloadUrl",
        "if ($LASTEXITCODE -ne 0) { throw \"aria2c \u4e0b\u8f7d QQ \u5931\u8d25\uff0c\u9000\u51fa\u4ee3\u7801\uff1a$LASTEXITCODE\" }",
        "Expand-7zipArchive -Path \"$dir\\QQ-NT.exe\" -DestinationPath $dir -ExtractDir 'Files' -Removal",
        "Remove-Item \"$dir\\windowsConfig.js\" -Force"
    ],
    "shortcuts": [
        [
            "QQ.exe",
            "QQ"
        ]
    ],
    "checkver": {
        "url": "https://qq-web.cdn-go.cn/im.qq.com_new/latest/rainbow/windowsConfig.js",
        "regex": "QQNT/[\\d.]+/release/([a-f0-9]+)/QQ_([\\d.]+)_(\\d+)_x64_01\\.exe",
        "replace": "${2}.${3}"
    },
    "autoupdate": {
        "url": "https://qq-web.cdn-go.cn/im.qq.com_new/latest/rainbow/windowsConfig.js"
    }
}
